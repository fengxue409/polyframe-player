{
  "name": "@polyframe/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "PolyFrame Player 桌面端（Electron + Vue3 + Pinia）",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "dist": "electron-vite build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.polyframe.player",
    "productName": "PolyFrame Player",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "../core/target/release/pf-core.exe",
        "to": "pf-core/pf-core.exe"
      },
      {
        "from": "../core/vendor/mpv/libmpv-2.dll",
        "to": "pf-core/libmpv-2.dll"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PolyFrame Player"
    }
  },
  "dependencies": {
    "@polyframe/shared": "workspace:*",
    "hls.js": "^1.7.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
